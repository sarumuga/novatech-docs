    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const label = item.json.label;\n  const lines = String(item.json.content).split(/\\r?\\n/);\n  let cur = { title: [], body: [] };\n  let prevBlank = false;\n  const flush = () => {\n    if (cur.body.length) {\n      const content = [...cur.title, ...cur.body].join('\\n').trim();\n      if (content.length > 30) out.push({ json: { label, section: cur.title.join(' | '), content } });\n    }\n    cur = { title: [], body: [] };\n  };\n  for (const raw of lines) {\n    const t = raw.trim();\n    if (!t) { prevBlank = true; continue; }\n    const isHeading = /[A-Z]/.test(t) && !/[a-z]/.test(t) && t.length >= 6;\n    const isSpeaker = /^[A-Z][A-Za-z.' -]+ \\([^)]+\\):$/.test(t);\n    const isQuoteStart = prevBlank && t.startsWith('\"') && cur.body.length > 0;\n    if (isHeading || isSpeaker) {\n      if (cur.body.length) flush();\n      cur.title.push(t);\n    } else if (isQuoteStart) {\n      flush();\n      cur.title.push('Quote');\n      cur.body.push(t);\n    } else {\n      cur.body.push(t);\n    }\n    prevBlank = false;\n  }\n  flush();\n}\nreturn out;"
      },
